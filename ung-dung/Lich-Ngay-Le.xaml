<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lịch ngày lễ" Width="565" Height="495" MinWidth="420" MinHeight="310"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13"
        Background="#FBF4EF">
  <DockPanel Margin="14">
    <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,12">
      <Label Content="_Năm" Target="{Binding ElementName=CalendarYear}" Padding="0,4,12,4"/>
      <ComboBox x:Name="CalendarYear" AutomationProperties.Name="Năm" Width="94"/>
      <Button Content="Đóng" IsCancel="True" Margin="12,0,0,0" Padding="12,2"/>
    </StackPanel>
    <DataGrid x:Name="CalendarRows" AutoGenerateColumns="False" IsReadOnly="True"
              CanUserAddRows="False" CanUserDeleteRows="False" RowHeaderWidth="0"
              GridLinesVisibility="Horizontal" Background="White"
              AlternatingRowBackground="#FBF4EF" HeadersVisibility="Column">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Ngày" Width="104" Binding="{Binding Date, StringFormat=dd/MM/yyyy}"/>
        <DataGridTextColumn Header="Ngày lễ" Width="*" Binding="{Binding Name}">
          <DataGridTextColumn.ElementStyle>
            <Style TargetType="TextBlock">
              <Setter Property="TextWrapping" Value="Wrap"/>
              <Setter Property="Padding" Value="4"/>
            </Style>
          </DataGridTextColumn.ElementStyle>
        </DataGridTextColumn>
        <DataGridTextColumn Header="Khu vực" Width="85" Binding="{Binding Region}"/>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
